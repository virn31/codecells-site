{
  "functions": {
    "api/nova.js": { "maxDuration": 60 },
    "api/ficha.js": { "includeFiles": "directorio/medico.html" }
  },
  "crons": [
    { "path": "/api/resumen-semanal", "schedule": "0 16 * * 1" }
  ],
  "rewrites": [
    { "source": "/api/resumen-semanal", "destination": "/api/citas?accion=resumen_semanal" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/directorio/:liga([a-z0-9-]+)", "destination": "/api/ficha?liga=:liga" },
    { "source": "/aviso-privacidad", "destination": "/aviso-privacidad.html" }
  ],
  "redirects": [
    { "source": "/buscar-medico.html", "destination": "/directorio", "permanent": true }
  ],
  "headers": [
    {
      "source": "/portal-vip.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/dezawavip.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/portal-medico.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/sw-vip.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/manifest-vip.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/code-cells-network/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/code-cells-network/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/mi-nivel.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/capacitacion/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/capacitacion/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/capacitacion/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
